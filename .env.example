# =====================================================================
# CampusSaathi - Environment Configuration Template
# =====================================================================
# NEVER commit production credentials or actual secrets into Git.
# Copy this file to `server/.env` for local backend development.
# Configure these variables in Render / Neon / Vercel dashboards for production.

# ---------------------------------------------------------------------
# SERVER ENVIRONMENT
# ---------------------------------------------------------------------
# Port on which the backend server listens (Render sets PORT automatically)
PORT=5001

# Application environment: 'development' or 'production'
NODE_ENV=development

# Frontend Client URL for CORS policy and cookie authorization
# In production on Render: set to your Vercel URL (e.g. https://your-app.vercel.app)
# Supports comma-separated list of origins if multiple URLs are needed
CLIENT_URL=http://localhost:5173

# Optional: Set to 'true' to allow dynamic Vercel preview URLs (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false

# ---------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ---------------------------------------------------------------------
# 64-character cryptographically random secret string used to sign JWTs.
# Generate on Linux/Mac/Git-Bash with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_min_32_bytes_random_hex_here

# JWT expiration duration (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h

# ---------------------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# Database provider toggle: 'postgresql' (Production / Neon) or 'sqlite' (Local Dev)
DB_PROVIDER=postgresql

# Production PostgreSQL Connection URL (e.g., Neon serverless PostgreSQL, Supabase, Render PostgreSQL)
# Format: postgresql://<user>:<password>@<neon-hostname>/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local SQLite Database URL (Used only when DB_PROVIDER=sqlite)
SQLITE_DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------
# FILE STORAGE & UPLOADS
# ---------------------------------------------------------------------
# Maximum file upload size in megabytes
MAX_FILE_SIZE_MB=5

# Relative or absolute directory for storing uploaded images
UPLOAD_DIR=./uploads
