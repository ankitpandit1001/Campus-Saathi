{
  "name": "campussaathi",
  "version": "1.0.0",
  "description": "CampusSaathi - College Issue & Complaint Management Platform",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "db:setup": "npm --prefix server run db:setup",
    "seed": "npm --prefix server run seed",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test": "npm --prefix server run test",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build"
  }
}
