# Backend Environment Variables Example (server/.env)
# Do not commit real passwords or secrets to Git.

PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false

JWT_SECRET=your_super_secret_jwt_key_min_32_bytes_random_hex_here
JWT_EXPIRES_IN=24h

# Database Configuration
# Set DB_PROVIDER to 'postgresql' for production (Neon, Supabase, etc.) or 'sqlite' for zero-config local dev
DB_PROVIDER=sqlite
SQLITE_DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads
